# ── Backend environment variables ────────────────────────────
# Copy this file to .env and fill in the values.

# Server
PORT=3001
NODE_ENV=development

# PostgreSQL (match docker-compose.yml)
DATABASE_URL=postgresql://seatsync:seatsync_dev@localhost:5433/seatsync

# Redis (match docker-compose.yml)
REDIS_URL=redis://localhost:6380

# JWT
JWT_SECRET=change-this-to-a-random-string
JWT_EXPIRES_IN=7d

# Hold timer (seconds)
HOLD_TTL=300

# Institutional email domain(s) for Student & Faculty registration
CAMPUS_EMAIL_DOMAINS=hyderabad.bits-pilani.ac.in

# ── Email Service Configuration (for real OTP delivery) ────────
# OPTION 1: Gmail (Recommended - Free, Instant)
# 1. Turn on 2-Step Verification in Google Account -> Security
# 2. Go to https://myaccount.google.com/apppasswords and create an App Password (16 chars)
# 3. Fill in:
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# OPTION 2: Custom SMTP (Resend, Brevo, SendGrid, Amazon SES)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxx
# SMTP_FROM="SeatSync <onboarding@resend.dev>"
